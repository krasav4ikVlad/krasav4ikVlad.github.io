# ================= MongoDB =================
# База бота. Для mongod на хосте из docker-compose:
#   mongodb://host.docker.internal:27017
# Change streams (мгновенная live-лента) требуют replica set; без него
# дашборд работает, лента обновляется с частотой ETL.
MONGO_URI=mongodb://host.docker.internal:27017
MONGO_DB=vpn_bot
USERS_COLLECTION=users

# ================= Remnawave =================
REMNAWAVE_API_URL=https://panel.example.com
REMNAWAVE_TOKEN=

# ================= Auth =================
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_HOURS=72
ADMIN_USERNAME=admin
# Сгенерировать: python3 -c "import bcrypt; print(bcrypt.hashpw(b'ПАРОЛЬ', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=
# Второй админ (опционально)
ADMIN2_USERNAME=
ADMIN2_PASSWORD_HASH=
# true в проде за https; false для локальной разработки по http
COOKIE_SECURE=true

# ================= Telegram-алерты =================
TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=

# ================= Джобы =================
ETL_INTERVAL_MINUTES=5
ALERTS_INTERVAL_MINUTES=5
# Минимальный порог "тишины" провайдера, часов (адаптивно повышается по медиане)
PROVIDER_SILENCE_HOURS=6
ALERT_COOLDOWN_HOURS=6

# ================= Прочее =================
DASHBOARD_PORT=8080
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
