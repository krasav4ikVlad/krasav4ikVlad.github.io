# Имена переменных совпадают с текущим config.py — значения переносятся один в один.

# ── Telegram ────────────────────────────────────────────────────────────────
API_TOKEN=                      # токен бота (в старом config.py — API_TOKEN)
ADMIN_IDS=802421217,1107871653  # раньше было зашито в loader.py

# ── База ────────────────────────────────────────────────────────────────────
TOKEN_DB=mongodb://localhost:27017   # строка подключения (имя из старого config.py)
MONGO_DB=RS_2

# ── Панель Remnawave ────────────────────────────────────────────────────────
REMNAWAVE_TOKEN=              # токен панели, ей идут все запросы про подписки

# ── Старый «core»-API (необязательно, можно оставить пустым) ────────────────
# Другой сервис, не Remnawave: эндпоинты /renew и /info, отдаёт servers_info
# с трафиком по каждому серверу. В текущем боте его читают две функции
# (renew_vpn_config и _fetch_total_traffic), и обе не вызываются — единственный
# вызов закомментирован в start.py.
API_URL=
API_TOKEN_CORE=
HAPP_RSA_PUBLIC_KEY=
VPN_BASE_SQUAD_ID=727b7629-6c08-47dc-8741-33501be0e5b7
VPN_CONNECT_BASE=https://connect.rsvps.tech/
PANEL_DRY_RUN=                # 1 для тестового контура: изменения в панель не уходят
REMNAWAVE_WEBHOOK_SECRET=   # сейчас записан прямо в lifeline.py — перевыпустить

# ── Платёжные системы (пустой ключ = провайдер не поднимается) ───────────────
CARDLINK_ACCESS_TOKEN=
CARDLINK_SHOP_ID=
WATA_ACCESS_TOKEN=
WATA_ACCESS_TOKEN_VISA=
HELEKET_API_KEY=
HELEKET_MERCHANT_ID=
SEVER_API_KEY=
SEVER_WEB_API_KEY=
TRIBUTE_API_KEY=                # сейчас записан прямо в FastApi.py — перевыпустить
