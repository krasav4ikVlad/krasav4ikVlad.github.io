CLOUDPAYMENTS_API_SECRET=

# ── Аналитика ───────────────────────────────────────────────────────────────
API_URL_STATS=
API_KEY_STATS=

# ── Прочее ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=production
API_PORT=8000
MEDIA_DIR=media
LEGACY_COLLECTIONS=           # 1 — работать на старых именах коллекций (с пробелом),
