# --- MongoDB (та же база, что у бота) ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB=RS_2

# --- Auth ---
# Обязательный. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=720

# --- Telegram (бот техподдержки — для тикетов на сайте) ---
# Токен САППОРТ-бота (того же, что ведёт треды в чате поддержки)
TG_BOT_TOKEN=
# ID чата поддержки с топиками, вида -100xxxxxxxxxx
SUPPORT_CHAT_ID=0

# --- Remnawave ---
REMNAWAVE_BASE_URL=https://panel.example.com
REMNAWAVE_TOKEN=

# --- Server ---
HOST=127.0.0.1
PORT=8100
# CORS нужен только если фронт на другом домене; при раздаче фронта этим же сервисом — оставить пустым
CORS_ORIGINS=
