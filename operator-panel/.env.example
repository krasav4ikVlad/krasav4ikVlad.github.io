# --- MongoDB (та же база, что у бота) ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB=RS_2

# --- Auth ---
# Обязательный. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=720

# --- Telegram (бот техподдержки — для тикетов на сайте) ---
# Токен САППОРТ-бота (того же, что ведёт треды в чате поддержки)
TG_BOT_TOKEN=
# ID чата поддержки с топиками, вида -100xxxxxxxxxx
SUPPORT_CHAT_ID=0

# --- Быстрые ответы (общая с ботом коллекция) ---
# По умолчанию берутся из той же Mongo/базы, коллекция support_quick_replies.
# Панель сама находит вариант имени с пробелами (в боте коллекция исторически
# называется 'support_quick_replies ' — с хвостовым пробелом). Если бот держит
# их в ДРУГОМ Mongo или базе — раскомментируйте и укажите свои значения:
#QUICK_REPLIES_MONGO_URL=mongodb://user:pass@host:27017
#QUICK_REPLIES_DB=RS_2
#QUICK_REPLIES_COLLECTION=support_quick_replies

# --- ИИ-помощник (черновики ответов в тикетах) ---
# Ключ API из console.anthropic.com -> API Keys. Пусто = кнопка «Ответ ИИ» вернёт ошибку настройки
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
# low = быстрые черновики; medium/high = вдумчивее, но дольше
AI_EFFORT=low
# Если сервер в регионе без прямого доступа к api.anthropic.com (например, РФ),
# укажите прокси: http://user:pass@host:port или socks5://host:port
#AI_PROXY_URL=

# --- Remnawave ---
REMNAWAVE_BASE_URL=https://panel.example.com
REMNAWAVE_TOKEN=

# --- Server ---
HOST=127.0.0.1
PORT=8100
# CORS нужен только если фронт на другом домене; при раздаче фронта этим же сервисом — оставить пустым
CORS_ORIGINS=
